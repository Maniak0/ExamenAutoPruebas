<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  Sistema de Reservas Turísticas (SRT) - Proyecto de Automatización de Pruebas
  Asignatura : Automatización de Pruebas - Unidades I, II y III
  Institución: IPLACEX - Escuela de Informática y Telecomunicaciones
  ============================================================================
  Este pom.xml centraliza la gestión de dependencias y la automatización del
  ciclo de construcción. Todas las versiones se declaran de forma EXPLÍCITA en
  <properties> para garantizar builds reproducibles y deterministas, evitando
  el anti-patrón de "versiones flotantes" descrito en el Módulo de Estudio 1.
  ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- === Identificación del artefacto (Identificación de Configuración, ME_2 §1.3) === -->
    <groupId>com.iplacex.qa</groupId>
    <artifactId>reservas-automatizacion</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Sistema de Reservas Turísticas - Automatización de Pruebas</name>
    <description>
        Proyecto base para la implementación de pipelines de Integración Continua y
        tuberías de despliegue con pruebas automatizadas en sus niveles unitario,
        de integración, de aceptación y end-to-end.
    </description>

    <!-- ======================================================================
         PROPIEDADES: versiones explícitas y centralizadas.
         Actualizar una versión aquí la propaga a todo el proyecto (ME_1 §2.6).
         ====================================================================== -->
    <properties>
        <!-- Plataforma -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Frameworks de prueba -->
        <junit.jupiter.version>5.10.2</junit.jupiter.version>
        <!-- JUnit Platform acompaña a Jupiter: 5.10.x se corresponde con 1.10.x -->
        <junit.platform.version>1.10.2</junit.platform.version>
        <testng.version>7.9.0</testng.version>
        <mockito.version>5.11.0</mockito.version>
        <assertj.version>3.25.3</assertj.version>
        <selenium.version>4.19.1</selenium.version>
        <webdrivermanager.version>5.7.0</webdrivermanager.version>
        <cucumber.version>7.15.0</cucumber.version>

        <!-- Plugins del ciclo de vida -->
        <surefire.version>3.2.5</surefire.version>
        <failsafe.version>3.2.5</failsafe.version>
        <jacoco.version>0.8.11</jacoco.version>
        <compiler.plugin.version>3.13.0</compiler.plugin.version>
        <jar.plugin.version>3.4.1</jar.plugin.version>

        <!-- Umbral del Quality Gate de cobertura (ME_5 §1.3.2: cobertura mínima >= 80%) -->
        <jacoco.linea.minima>0.80</jacoco.linea.minima>

        <!-- Puertos usados por las pruebas de integración y aceptación -->
        <test.puerto.integracion>18080</test.puerto.integracion>
        <test.url.aceptacion>http://localhost:18080</test.url.aceptacion>
    </properties>

    <!-- ======================================================================
         DEPENDENCIAS DE PRUEBA
         La aplicación bajo prueba no utiliza dependencias externas de runtime
         (se apoya en el JDK), de modo que el árbol de dependencias contiene
         exclusivamente librerías de testing con alcance <scope>test</scope>.
         ====================================================================== -->
    <dependencies>

        <!-- === Nivel 1: PRUEBAS UNITARIAS (JUnit 5) === -->
        <!-- Cada dependencia declara su versión de forma explícita. Se evita a
             propósito el BOM importado: una sola fuente de versiones ubicada en
             <properties> es más fácil de auditar y no depende de resolver un
             artefacto adicional para que el proyecto sea legible. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Necesario para que Surefire descubra y ejecute los tests de JUnit 5 -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>${junit.platform.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- === Dobles de prueba: aislamiento de dependencias (ME_3) === -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- === Aserciones fluidas y legibles === -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- === Framework de pruebas alternativo === -->
        <!-- TestNG queda declarado y disponible para escribir suites con grupos,
             prioridades y ejecución paralela. La suite de este proyecto se
             estandarizó en JUnit 5 de forma deliberada: mantener un único
             proveedor de pruebas evita que Surefire deba resolver entre dos
             frameworks en el mismo classpath, que es una fuente habitual de
             ejecuciones inconsistentes en los agentes de CI. -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- === Nivel 4: PRUEBAS E2E DE INTERFAZ (Selenium WebDriver) === -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Descarga y configura automáticamente el binario del navegador,
             eliminando la dependencia implícita de un driver instalado a mano
             (anti-patrón "dependencias implícitas", ME_5 §1.2.3). -->
        <dependency>
            <groupId>io.github.bonigarcia</groupId>
            <artifactId>webdrivermanager</artifactId>
            <version>${webdrivermanager.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- === BDD: especificaciones ejecutables en Gherkin (ME_4 §1.1) === -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <version>${junit.platform.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ====================================================================== -->
    <build>
        <finalName>reservas-automatizacion</finalName>

        <plugins>

            <!-- ============ Compilación ============ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler.plugin.version}</version>
                <configuration>
                    <release>17</release>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- ============ Empaquetado ejecutable ============ -->
            <!-- Genera el artefacto desplegable que recorrerá el deployment
                 pipeline: el MISMO .jar se promueve de staging a producción
                 (principio "build once, deploy many", ME_5 §1.4.1). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${jar.plugin.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.iplacex.qa.reservas.api.Main</mainClass>
                        </manifest>
                        <manifestEntries>
                            <!-- Metadatos de auditoría embebidos en el artefacto (ME_6 §5.3) -->
                            <Implementation-Version>${project.version}</Implementation-Version>
                            <Build-Timestamp>${maven.build.timestamp}</Build-Timestamp>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- ============ NIVEL 1 y 2: PRUEBAS UNITARIAS (fase test) ============ -->
            <!-- Surefire ejecuta SOLO pruebas rápidas y aisladas. Es el gate de
                 feedback inmediato de la etapa de commit (ME_5 §1.3). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <includes>
                        <include>**/unit/**/*Test.java</include>
                    </includes>
                    <excludes>
                        <!-- Las E2E son lentas: se aíslan en el perfil 'e2e' -->
                        <exclude>**/e2e/**</exclude>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                    <!-- Paralelización mínima para acelerar el feedback (ME_5 §1.3.3) -->
                    <parallel>classes</parallel>
                    <threadCount>2</threadCount>
                    <reportFormat>plain</reportFormat>
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
            </plugin>

            <!-- ====== NIVEL 3: PRUEBAS DE INTEGRACIÓN Y ACEPTACIÓN (fase verify) ====== -->
            <!-- Failsafe separa las pruebas lentas del ciclo rápido y garantiza
                 que el post-integration-test se ejecute aunque las pruebas fallen,
                 permitiendo liberar siempre los recursos del ambiente. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${failsafe.version}</version>
                <configuration>
                    <includes>
                        <include>**/integracion/**/*IT.java</include>
                        <include>**/aceptacion/**/*IT.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <test.puerto>${test.puerto.integracion}</test.puerto>
                        <test.baseUrl>${test.url.aceptacion}</test.baseUrl>
                    </systemPropertyVariables>
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
                <executions>
                    <execution>
                        <id>pruebas-integracion</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- ============ Quality Gate de cobertura ============ -->
            <!-- JaCoCo instrumenta el código y detiene el build si la cobertura
                 cae bajo el umbral definido (ME_5 §1.2.2: "umbrales claros"). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <!-- Las reglas del umbral se declaran a nivel de PLUGIN y no dentro
                     de una <execution>. Una configuración anidada en la ejecución
                     solo aplica cuando el goal corre ligado a la fase verify; si el
                     pipeline invoca 'mvn jacoco:check' directamente, Maven no la ve
                     y el build aborta por falta de reglas. A nivel de plugin, el
                     mismo umbral rige en ambos casos. -->
                <configuration>
                    <rules>
                        <rule>
                            <element>BUNDLE</element>
                            <limits>
                                <limit>
                                    <counter>LINE</counter>
                                    <value>COVEREDRATIO</value>
                                    <minimum>${jacoco.linea.minima}</minimum>
                                </limit>
                            </limits>
                        </rule>
                    </rules>
                </configuration>
                <executions>
                    <execution>
                        <id>preparar-agente</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>generar-reporte</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>verificar-umbral-cobertura</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <!-- ======================================================================
         PERFILES: diferenciación de entornos y suites (ME_1 §2.6 buenas prácticas)
         ====================================================================== -->
    <profiles>

        <!-- Perfil por defecto: ciclo rápido para la etapa de commit -->
        <profile>
            <id>ci-rapido</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <skip.e2e>true</skip.e2e>
            </properties>
        </profile>

        <!-- Perfil E2E: ejecuta la suite Selenium contra un navegador headless.
             Uso: mvn verify -Pe2e -Dselenium.headless=true -->
        <profile>
            <id>e2e</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>${failsafe.version}</version>
                        <configuration>
                            <includes>
                                <include>**/e2e/**/*Test.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <selenium.headless>true</selenium.headless>
                                <test.baseUrl>${test.url.aceptacion}</test.baseUrl>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Perfil de aceptación: usado por el Acceptance Gate del deployment
             pipeline contra el ambiente de staging ya desplegado.
             Uso: mvn verify -Paceptacion -Dtest.baseUrl=http://staging:8080 -->
        <profile>
            <id>aceptacion</id>
            <build>
                <plugins>
                    <!-- El gate valida un ambiente YA desplegado: las pruebas
                         unitarias ya se ejecutaron en el Commit Stage y no
                         corresponde repetirlas aquí. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>${surefire.version}</version>
                        <configuration>
                            <skipTests>true</skipTests>
                        </configuration>
                    </plugin>
                    <!-- JaCoCo solo mide el código que ejecuta este mismo proceso
                         de Maven. Contra staging, la aplicación corre en OTRO
                         proceso, por lo que la cobertura medida sería 0% y el
                         umbral del 80% rechazaría una versión correcta. La
                         cobertura es responsabilidad del pipeline de CI. -->
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>${jacoco.version}</version>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>${failsafe.version}</version>
                        <configuration>
                            <includes>
                                <include>**/aceptacion/**/*IT.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>

</project>
